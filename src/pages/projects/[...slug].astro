---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import type { MetaData } from '~/types';

export const prerender = true;

export const getStaticPaths = (async () => {
  // smartclinic and mentora-mobile have their own custom-designed pages
  // (src/pages/projects/smartclinic.astro, mentora-mobile.astro) — excluded here
  // to avoid a route collision with those static files.
  const customPageIds = new Set(['smartclinic', 'mentora-mobile']);
  const entries = await getCollection('projects', ({ id, data }) => !data.draft && !customPageIds.has(id));
  return Promise.all(
    entries.map(async (entry) => {
      const { Content } = await render(entry);
      return {
        params: { slug: entry.id },
        props: { project: { id: entry.id, ...entry.data }, Content },
      };
    })
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, Content } = Astro.props as Props;

const url = getCanonical(getPermalink(`projects/${project.id}`));
const image = (await findImage(project.image)) as ImageMetadata | string | undefined;

const metadata: MetaData = {
  title: project.title,
  description: project.summary,
  ...(project.metadata ?? {}),
  canonical: project.metadata?.canonical || String(url),
};

const links = [
  project.links?.frontend && { text: 'Frontend Repo', href: project.links.frontend },
  project.links?.backend && { text: 'Backend Repo', href: project.links.backend },
  project.links?.repo && { text: 'View Repo', href: project.links.repo },
].filter(Boolean) as { text: string; href: string }[];
---

<Layout metadata={metadata}>
  <section class="py-8 sm:py-16 lg:py-20 mx-auto">
    <article>
      <header>
        <div class="max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 flex flex-wrap items-center gap-2 text-sm">
          {project.category && <span class="font-semibold uppercase tracking-wide text-primary">{project.category}</span>}
          {
            project.status === 'ongoing' && (
              <span class="rounded-full bg-blue-100 px-2 py-0.5 font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                Ongoing
              </span>
            )
          }
        </div>

        <h1 class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
          {project.title}
        </h1>

        <p class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400">
          {project.role === 'contributed' && <span class="font-semibold">Contributed to: </span>}
          {project.summary}
        </p>

        {
          image ? (
            <Image
              src={image}
              class="max-w-full lg:max-w-[900px] max-h-130 w-auto object-contain mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
              widths={[400, 900]}
              sizes="(max-width: 900px) 400px, 900px"
              alt={project.title}
              width={900}
              format="webp"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="max-w-3xl mx-auto px-4 sm:px-6">
              <div class="border-t dark:border-slate-700" />
            </div>
          )
        }
      </header>

      <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex flex-wrap gap-2">
        {
          project.stack.map((tech) => (
            <span class="rounded bg-gray-100 px-2.5 py-1 text-sm text-gray-700 dark:bg-slate-800 dark:text-slate-300">
              {tech}
            </span>
          ))
        }
      </div>

      <div
        class="mx-auto px-6 sm:px-6 max-w-3xl prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 mt-8 prose-li:my-0"
      >
        <Content />
      </div>

      {
        links.length > 0 && (
          <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex flex-wrap gap-4">
            {links.map((link) => (
              <Button variant="primary" href={link.href} target="_blank">
                {link.text}
              </Button>
            ))}
          </div>
        )
      }

      <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-10">
        <Button variant="link" href={getPermalink('/#projects')}>&larr; Back to all projects</Button>
      </div>
    </article>
  </section>
</Layout>
