---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Contact from '~/components/widgets/Contact.astro';
import HashnodeLatest from '~/components/widgets/HashnodeLatest.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ProjectsGrid from '~/components/projects/Grid.astro';

import { getProjects } from '~/utils/projects';

const metadata = {
  title: 'Supuni Dissanayake — IT Undergraduate & Full-Stack Developer',
};

const projects = await getProjects();
const featuredIds = ['mentora', 'smartclinic', 'aes-glove', 'mentora-mobile'];
const otherIds = ['umisf-website', '3d-city-explorer'];
const isDefined = <T,>(value: T | undefined): value is T => value !== undefined;
const featuredProjects = featuredIds.map((id) => projects.find((p) => p.id === id)).filter(isDefined);
const otherProjects = otherIds.map((id) => projects.find((p) => p.id === id)).filter(isDefined);

const contactLinks = [
  { ariaLabel: 'Email', icon: 'tabler:mail', href: 'mailto:dissanayakesupuni423@gmail.com' },
  { ariaLabel: 'GitHub', icon: 'tabler:brand-github', href: 'https://github.com/supuni423' },
  {
    ariaLabel: 'LinkedIn',
    icon: 'tabler:brand-linkedin',
    href: 'https://www.linkedin.com/in/supuni-dissanayake-081818315',
  },
  { ariaLabel: 'Hashnode', icon: 'simple-icons:hashnode', href: 'https://supunihashnodedev.hashnode.dev' },
];
---

<Layout metadata={metadata}>
  <!-- Hero ******************* -->

  <Hero2
    id="home"
    image={{
      src: '~/assets/images/headshot.jpg',
      alt: 'Supuni Dissanayake',
      width: 420,
      height: 420,
      class: 'mx-auto rounded-2xl shadow-lg w-full',
      style: 'max-width: 320px',
    }}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white">Supuni Dissanayake</span>
    </Fragment>

    <Fragment slot="subtitle">
      Information Technology Undergraduate &bull; Full-Stack Development, UI/UX Design &amp; AI-Integrated Applications
    </Fragment>

    <Fragment slot="actions">
      <div class="flex w-full sm:w-auto">
        <a class="btn-primary w-full sm:mb-0" href="#projects">View Projects</a>
      </div>
      <div class="flex w-full sm:w-auto">
        <a class="btn-secondary w-full sm:mb-0" href="#contact">Contact Me</a>
      </div>
      <div class="flex w-full sm:w-auto">
        <a class="btn-secondary w-full sm:mb-0" href="/cv/Supuni-Dissanayake-CV.pdf" download>Download CV</a>
      </div>
    </Fragment>
  </Hero2>

  <!-- About Me ******************* -->

  <WidgetWrapper id="about" containerClass="max-w-7xl mx-auto">
    <Headline tagline="About Me" title="A little about me" />
    <div class="max-w-3xl mx-auto space-y-6 text-lg text-muted dark:text-slate-400">
      <p>
        Motivated 3rd-year Information Technology undergraduate at the University of Moratuwa with hands-on
        experience in full-stack web development and academic software projects. Strong interest in Software
        Engineering, Full-Stack Development, and UI/UX Design, with a passion for creating user-friendly and visually
        appealing digital experiences.
      </p>
      <p>
        Skilled in developing responsive web applications using modern technologies and proficient in graphic design
        using Adobe Creative Suite tools. Eager to combine technical and creative skills to build efficient,
        impactful software solutions.
      </p>
    </div>
  </WidgetWrapper>

  <!-- Skills ******************* -->

  <Features2
    id="skills"
    tagline="Skills"
    title="What I work with"
    columns={3}
    items={[
      {
        title: 'Frontend Development',
        description: 'HTML, CSS, React.js, Next.js, Tailwind CSS, Flutter',
        icon: 'tabler:code',
      },
      {
        title: 'Backend Development',
        description: 'Node.js, Express.js, Spring Boot (Java), FastAPI (Python)',
        icon: 'tabler:server-2',
      },
      {
        title: 'Programming Languages',
        description: 'Java, Python, JavaScript, TypeScript, Dart, C',
        icon: 'tabler:terminal-2',
      },
      {
        title: 'CS Fundamentals',
        description: 'Object-Oriented Programming (OOP), Data Structures & Algorithms, REST API Design',
        icon: 'tabler:cpu',
      },
      {
        title: 'Databases',
        description: 'PostgreSQL, MySQL, Microsoft SQL Server',
        icon: 'tabler:database',
      },
      {
        title: 'Security',
        description: 'JWT, Role-Based Access Control (RBAC)',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Tools & Platforms',
        description: 'Git, GitHub, VS Code, Postman, Docker',
        icon: 'tabler:tool',
      },
      {
        title: 'Design & UI/UX',
        description: 'UI/UX Design, Figma, Canva, Adobe Photoshop, Adobe Illustrator',
        icon: 'tabler:palette',
      },
    ]}
  />

  <!-- Featured Projects ******************* -->

  <WidgetWrapper id="projects" containerClass="max-w-7xl mx-auto">
    <Headline tagline="⭐ Featured Projects" title="Things I've built" subtitle="Detailed case studies" />
    <ProjectsGrid projects={featuredProjects} />

    <div class="mt-20">
      <Headline tagline="📱 Other Selected Projects" title="More from my work" />
      <ProjectsGrid projects={otherProjects} />
    </div>
  </WidgetWrapper>

  <!-- Education & Achievements ******************* -->

  <Steps2
    id="education"
    tagline="Education & Achievements"
    title="Education"
    items={[
      {
        title: 'BSc (Hons) in Information Technology — University of Moratuwa',
        description: '2024 – Present · CGPA 3.2',
      },
      {
        title: 'G.C.E. Advanced Level — Maliyadeva Balika Vidyalaya',
        description: 'Biological Science Stream, 2023 · Biology B, Physics B, Chemistry A',
      },
      {
        title: 'G.C.E. Ordinary Level — Maliyadeva Balika Vidyalaya',
        description: '2019 · 9 A Passes',
      },
    ]}
  />

  <WidgetWrapper containerClass="max-w-5xl mx-auto pt-0 md:pt-0">
    <Headline title="Certifications & Additional Qualifications" />
    <div class="flex flex-wrap justify-center gap-2.5">
      {
        [
          'Diploma in English Language (Merit Pass) — Wayamba University, 2023',
          'Diploma in Graphic Design — SIPWAY Campus, 2023',
          'NVQ Level 4 — Bridal Dressing, 2024',
          'Devthon 3.0 Hackathon — Participant',
        ].map((item) => (
          <span class="rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 px-4 py-2 text-sm text-muted dark:text-slate-400">
            {item}
          </span>
        ))
      }
    </div>
  </WidgetWrapper>

  <!-- Technical Writing ******************* -->

  <HashnodeLatest id="writing" title="Technical Writing" tagline="Latest from my blog" />

  <!-- Beyond Coding ******************* -->

  <Content
    id="beyond-coding"
    tagline="Beyond Coding"
    title="Badminton"
    image={{ src: '~/assets/images/badminton-team.jpg', alt: 'UMISF badminton team' }}
  >
    <Fragment slot="content">
      <p>
        Active Member, University of Moratuwa Badminton Team (2024–Present). 2nd Place, Women's Badminton Team at the
        Sri Lanka University Games (SLUG) 2025. Winner, Inter-Department Badminton Tournament (ShuttleStorm) 2023.
        Also helped organize the UMISF Badminton Tournament, an island-wide competitive event, in 2025/2026.
      </p>
    </Fragment>
  </Content>

  <Content
    id="creative-design"
    title="Creative Design"
    isReversed
    image={{ src: '~/assets/images/moraspirit.jpg', alt: 'MoraSpirit Crew 2025/26' }}
  >
    <Fragment slot="content">
      <p>
        Member of MoraSpirit's Creative Design Pillar, contributing to creative and design-related activities. Holds
        a Diploma in Graphic Design from SIPWAY Campus, and works with Figma, Canva, Adobe Photoshop, and Adobe
        Illustrator.
      </p>
    </Fragment>
  </Content>

  <!-- Contact ******************* -->

  <Contact
    id="contact"
    title="Let's Connect"
    subtitle="Have a project in mind or just want to say hi? Reach out."
    inputs={[
      { type: 'text', name: 'name', label: 'Name' },
      { type: 'email', name: 'email', label: 'Email' },
    ]}
    textarea={{ label: 'Message' }}
    button="Send Message"
    description="I'll get back to you as soon as I can."
  />

  <div class="max-w-7xl mx-auto px-4 pb-16 -mt-8 flex justify-center gap-3">
    {
      contactLinks.map(({ ariaLabel, icon, href }) => (
        <a
          class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-2.5 inline-flex items-center border border-gray-200 dark:border-gray-700"
          aria-label={ariaLabel}
          href={href}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <Icon name={icon} class="w-5 h-5" />
        </a>
      ))
    }
  </div>
</Layout>
